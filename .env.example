# Copy this file to .env and adjust as needed.

# Base URL of the Zylix API (apps/api from the zylix-main repo). The
# Next.js rewrites() in next.config.mjs proxy /api/* requests here.
API_URL=http://localhost:4000

# Only needed if the host's rewrite proxy can't reliably forward to an
# external origin — makes the browser call the API directly via CORS
# instead of the server-side rewrite. Leave unset for same-host/rewrite
# setups (e.g. Vercel, or Render with the API co-located).
NEXT_PUBLIC_API_URL=
