# Copy this file to .env and adjust as needed.

# PostgreSQL connection string (Vercel Postgres, Neon, or any Postgres host).
# If your provider gives you a pooled connection string (e.g. Neon's
# "-pooler" host, or Vercel Postgres' POSTGRES_PRISMA_URL), use that for
# DATABASE_URL — serverless functions open a lot of short-lived connections.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
