{
  "name": "zylixstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "render-build": "prisma migrate deploy && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "next": "15.1.3",
    "pg": "^8.22.0",
    "postcss": "8.4.49",
    "prisma": "^7.9.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.16",
    "typescript": "5.7.2"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.9"
  }
}
