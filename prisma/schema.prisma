// Prisma schema for the Zylixstore marketplace backend

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  icon String
  slug String @unique
}

model Product {
  id         String     @id @default(cuid())
  name       String
  category   String
  price      Int
  oldPrice   Int?
  tag        String?
  swatchFrom String
  swatchTo   String
  emoji      String
  createdAt  DateTime   @default(now())
  cartItems  CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  quantity  Int      @default(1)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
}

model SellerApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  brand     String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
